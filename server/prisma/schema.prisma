generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ExerciseSource {
  BASE
  CUSTOM
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  surname          String?
  age              Int?
  email            String   @unique
  password         String
  registrationDate DateTime @default(now())

  gender           String?
  birthDate        DateTime?
  weightKg         Float?
  heightCm         Float?

  workoutPlans     WorkoutPlan[]
  workouts         Workout[]
  appData          UserAppData?
  customExercises  Exercise[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model UserAppData {
  id        Int      @id @default(autoincrement())
  workouts  String   @default("[]")
  exercises String   @default("[]")
  history   String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_app_data")
}

model WorkoutPlan {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  exercises   WorkoutPlanExercise[]
  workouts    Workout[]

  @@index([userId])
  @@map("workout_plans")
}

model Exercise {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  muscleGroup  String
  subcategory  String?
  trackingType String       @default("weight_reps")
  source       ExerciseSource @default(BASE) @map("type")

  userId       Int?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  planExercises WorkoutPlanExercise[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([source])
  @@index([userId])
  @@map("exercises")
}

model WorkoutPlanExercise {
  id          Int @id @default(autoincrement())

  order       Int
  setsNumber  Int
  repsNumber  Int
  restSeconds Int @default(60)

  workoutPlanId Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  executedSets ExecutedSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutPlanId])
  @@index([exerciseId])
  @@map("workout_plan_exercises")
}

model Workout {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  startTime   DateTime @default(now())
  endTime     DateTime?
  completed   Boolean  @default(false)
  paused      Boolean  @default(false)
  notes       String?

  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutPlanId Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)

  executedSets ExecutedSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workoutPlanId])
  @@map("workouts")
}

model ExecutedSet {
  id          Int    @id @default(autoincrement())
  setNumber   Int
  repsDone    Int
  weightKg    Float?
  notes       String?

  workoutId   Int
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  workoutPlanExerciseId Int
  workoutPlanExercise   WorkoutPlanExercise @relation(fields: [workoutPlanExerciseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workoutId])
  @@index([workoutPlanExerciseId])
  @@map("executed_sets")
}
